    "agg_dict1 = {\n",
    "    'order_id': 'count',\n",
    "    'order_date': 'max',\n",
    "    'sales': 'sum'\n",
    "}\n",
    "df_rfm = df.groupby('customer_id').agg(agg_dict1).reset_index()\n",
    "df_rfm.columns = ['customer_id', 'frequency', 'max_date', 'monetary']\n",
    "df_rfm['recency'] = (today - df_rfm['max_date']).dt.days\n",
    "df_rfm.drop(['max_date'], axis=1, inplace=True)"
   ]
